{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "types": ["node"]
  },
  "include": ["server.ts", "server/**/*.ts", "data/**/*.ts", "types/**/*.ts", "utils/**/*.ts"],
  "exclude": ["node_modules"]
}